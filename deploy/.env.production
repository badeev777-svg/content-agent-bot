# ====================================
# Production .env для jino.ru VPS
# ====================================
# ЗАМЕНИТЕ значения на реальные перед развёртыванием!

# Telegram Bot
# Получить от @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter (для Claude через OpenRouter)
# Зарегистрируйтесь на https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-your_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=anthropic/claude-sonnet-4.6
ENABLE_PROMPT_CACHING=true
OPENROUTER_APP_NAME=Content Agent Bot
OPENROUTER_APP_URL=https://github.com/badeev777-svg/content-agent-bot

# Database
# Для Docker Compose используйте: postgresql+asyncpg://bot:{POSTGRES_PASSWORD}@postgres:5432/content_agent
# Для systemd используйте: postgresql+asyncpg://bot:{POSTGRES_PASSWORD}@localhost:5432/content_agent
DATABASE_URL=postgresql+asyncpg://bot:CHANGE_ME_SECURE_PASSWORD@postgres:5432/content_agent

# PostgreSQL пароль (для Docker Compose и локальных подключений)
POSTGRES_USER=bot
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# Логирование
LOG_LEVEL=INFO

# Telegram Chat ID админа для критических ошибок
# Ваш личный Telegram ID (можно получить от @userinfobot)
ADMIN_TELEGRAM_CHAT_ID=

# Telegram Payments
# Получить от @BotFather → /mybots → Payments
TELEGRAM_PAYMENT_TOKEN=

# Лимиты и ценообразование
FREE_GENERATIONS=3              # Бесплатных переписей до подписки
SUBSCRIPTION_PRICE_RUB=2499     # Цена подписки на месяц
RATE_LIMIT_PER_HOUR=1          # Макс запросов в час
MAX_REWRITES_PER_POST=3         # Макс переписей одного поста
SCRAPER_TIMEOUT_SECONDS=15      # Timeout для скрейпера контента

# Рабочее время (UTC для синхронизации на сервере)
# Лимиты переписей сбрасываются в 00:00 UTC
TZ=UTC
