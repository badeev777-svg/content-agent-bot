# === PRODUCTION ENVIRONMENT ===
# Copy this file to .env.production and fill in the actual values

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=your_actual_telegram_bot_token

# === OpenRouter LLM ===
OPENROUTER_API_KEY=sk-or-your_actual_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=anthropic/claude-sonnet-4.6
ENABLE_PROMPT_CACHING=true
OPENROUTER_APP_NAME=Content Agent Bot
OPENROUTER_APP_URL=https://github.com/badeev777-svg/content-agent-bot

# === Database (PostgreSQL on VPS) ===
DATABASE_URL=postgresql+asyncpg://bot:SECURE_PASSWORD@localhost:5432/content_agent
# Note: Use strong password, stored securely in .env.production (chmod 600)

# === Logging & Monitoring ===
LOG_LEVEL=INFO

# === Alerts (Optional) ===
# Telegram chat_id for critical errors (get from @userinfobot in private chat)
ADMIN_TELEGRAM_CHAT_ID=

# === Telegram Payments ===
# Get from @BotFather → /mybots → Payments
TELEGRAM_PAYMENT_TOKEN=

# === Business Logic ===
FREE_GENERATIONS=3
SUBSCRIPTION_PRICE_RUB=2499
RATE_LIMIT_PER_HOUR=1
MAX_REWRITES_PER_POST=3
SCRAPER_TIMEOUT_SECONDS=15
