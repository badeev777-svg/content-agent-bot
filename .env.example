# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-your_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=anthropic/claude-sonnet-4.6
ENABLE_PROMPT_CACHING=true
OPENROUTER_APP_NAME=Content Agent Bot
OPENROUTER_APP_URL=https://github.com/badeev777-svg/content-agent-bot

# Database
DATABASE_URL=postgresql+asyncpg://bot:bot@localhost:5432/content_agent
# Для локальных тестов: sqlite+aiosqlite:///./data/bot.db

# Логирование
LOG_LEVEL=INFO

# Алерты для CRITICAL ошибок (Telegram chat_id админа)
ADMIN_TELEGRAM_CHAT_ID=

# Telegram Payments (получить от @BotFather → /mybots → Payments)
TELEGRAM_PAYMENT_TOKEN=

# Лимиты
FREE_GENERATIONS=3
SUBSCRIPTION_PRICE_RUB=2499
RATE_LIMIT_PER_HOUR=1
MAX_REWRITES_PER_POST=3
SCRAPER_TIMEOUT_SECONDS=15

